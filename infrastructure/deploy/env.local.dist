APP_ENV=prod
APP_DEBUG=0
# openssl rand -hex 32
APP_SECRET=
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?serverVersion=10.6.0-MariaDB&charset=utf8mb4"
DEFAULT_URI=https://pdg.alexandrechauvin.fr
CORS_ALLOW_ORIGIN='^https://pdg\.alexandrechauvin\.fr$'

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://pdg.alexandrechauvin.fr/api/spotify/callback
SPOTIFY_MARKET=FR

# Encrypts the Spotify tokens at rest, never rotate it without reconnecting every host
# openssl rand -hex 32
APP_CRYPTO_KEY=

# The hub (hub/) runs as a separate Infomaniak Node.js site, see infrastructure/deploy/README.md.
# These URLs must stay non-empty: an empty MERCURE_URL selects FrankenPHP's built-in hub and breaks cache:clear
MERCURE_URL=https://HUB_HOST/.well-known/mercure
MERCURE_PUBLIC_URL=https://HUB_HOST/.well-known/mercure
# openssl rand -hex 32, the same value as MERCURE_PUBLISHER_JWT_KEY on the hub
MERCURE_JWT_SECRET=
MERCURE_JWT_ISSUER=https://pdg.alexandrechauvin.fr
MERCURE_JWT_AUDIENCE=https://pdg.alexandrechauvin.fr
