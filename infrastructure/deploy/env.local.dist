APP_ENV=prod
APP_DEBUG=0
# openssl rand -hex 32
APP_SECRET=
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?serverVersion=18&charset=utf8"
DEFAULT_URI=https://pdg.alexandrechauvin.fr
CORS_ALLOW_ORIGIN='^https://pdg\.alexandrechauvin\.fr$'

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://pdg.alexandrechauvin.fr/api/spotify/callback

# No Mercure hub in production yet, see TODO.md. These URLs must stay non-empty:
# an empty MERCURE_URL selects FrankenPHP's built-in hub and breaks cache:clear
MERCURE_URL=https://pdg.alexandrechauvin.fr/.well-known/mercure
MERCURE_PUBLIC_URL=https://pdg.alexandrechauvin.fr/.well-known/mercure
# openssl rand -hex 32
MERCURE_JWT_SECRET=
MERCURE_JWT_ISSUER=https://pdg.alexandrechauvin.fr
MERCURE_JWT_AUDIENCE=https://pdg.alexandrechauvin.fr
