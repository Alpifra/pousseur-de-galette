{
	# Browsers send no SNI when browsing an IP address (required by Spotify for loopback redirect URIs)
	default_sni {$SERVER_NAME:127.0.0.1}
}

{$SERVER_NAME:127.0.0.1} {
	log

	handle /.well-known/mercure* {
		reverse_proxy mercure:80
	}

	@api path /api* /_profiler* /_wdt* /bundles/*
	handle @api {
		root * /srv/app/public
		php_fastcgi php:9000
		encode zstd gzip
		file_server
	}

	handle {
		reverse_proxy front:5173
	}
}
