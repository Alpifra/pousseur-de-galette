#!/bin/sh
# Enable with: make hooks
set -e

cd "$(git rev-parse --show-toplevel)"

if ! docker compose -f infrastructure/docker/compose.yml ps --status running --services 2>/dev/null | grep -qx php; then
    echo "pre-commit: Docker stack down, lint skipped (make up)" >&2
    exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)

case "$staged" in
    *api/*) make -s lint-php ;;
esac

case "$staged" in
    *front/*) make -s lint-front ;;
esac
